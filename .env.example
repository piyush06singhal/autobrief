# Copy to .env and fill in. After setting DATABASE_URL + an LLM key below, run
# `npm run setup` to have the AI generate metrics for your database. See README.

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://report_user:report_pass@localhost:5432/report_db

# SendGrid (leave blank to skip sending and just save the PDF locally).
# API key scopes: "Mail Send" is required to send. "Suppressions: Read" is
# recommended — it lets the pipeline skip addresses that have already bounced or
# complained (a Mail-Send-only key just skips that filtering). Verify SENDGRID_
# FROM_EMAIL as a Sender, and authenticate its domain, or mail may be spam-
# foldered — run `npm run check:email` to check SPF/DKIM/DMARC. Must be a domain
# you own, not a freemail address (…@gmail.com won't authenticate).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=reports@yourcompany.com
REPORT_RECIPIENTS=exec1@yourcompany.com,exec2@yourcompany.com

# LLM — powers both `npm run setup` (AI writes your metric SQL) and the
# executive summary. Default provider is Groq (free key at console.groq.com).
#   - GROQ_API_KEY is REQUIRED for `npm run setup` / the "Regenerate with AI"
#     button. Leave it blank and the weekly report still runs, just with a
#     templated one-line summary instead of an AI-written one.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Point at any OpenAI-compatible provider (OpenAI, Together, a local server,
# ...) by changing this and using that provider's key. Defaults to Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model used by `npm run setup` to generate metric SQL. Schema-to-SQL benefits
# from a stronger model than the summary — point this at a bigger one if you
# like. Defaults to GROQ_MODEL when unset.
GENERATOR_MODEL=openai/gpt-oss-120b

# Cron schedule for the weekly job (default: every Monday 8am)
REPORT_CRON=0 8 * * 1
# The zone the report is "local" to — sets the cron fire time, the daily trend's
# day boundaries, AND the "week ending" label. Use an IANA name (e.g.
# America/New_York, Europe/London, Asia/Kolkata). Defaults to the system zone, so
# set this explicitly in Docker, where the container clock is usually UTC —
# otherwise "Monday 8am" fires at 8am UTC. An invalid value fails fast at startup.
REPORT_TIMEZONE=

# Failure alerting (both optional; leave blank to skip that channel).
# If neither is set, a failed run is only visible in run-log.json/container logs.
# These same channels are used by `npm run healthcheck -- --alert`, which can be
# cronned to alert you if the scheduler process itself dies (see the README).
SLACK_WEBHOOK_URL=
# Defaults to REPORT_RECIPIENTS if left blank.
ALERT_EMAIL=

# How many days of archived PDFs to keep in output/ (older ones are deleted
# automatically after each run).
RETENTION_DAYS=90

# Per-query timeout in milliseconds. Every metric/trend query is cancelled by
# Postgres if it runs longer than this. Raise it if you report on very large
# tables and a heavy aggregation legitimately needs more time.
DB_STATEMENT_TIMEOUT_MS=30000
# Max concurrent Postgres connections in the shared pool (metrics run in
# parallel). Bump only if you have many metrics and a DB that can take it.
DB_POOL_MAX=10

# Upper bound (ms) on any single headless-Chrome operation while rendering the
# PDF. Caps every DevTools call, so a Chrome that wedges or gets OOM-killed
# mid-render fails fast (and is retried once) instead of hanging the whole job
# forever. Raise it for very large reports on a slow host.
PDF_RENDER_TIMEOUT_MS=60000

# Admin dashboard login (HTTP Basic Auth). Leave both blank ONLY for local-only
# use — without these the dashboard has no login and anyone who can reach the
# port can trigger runs and download archived PDFs.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Terminate TLS at a reverse proxy (nginx/Caddy/cloud LB) in front of the admin
# dashboard — Basic Auth must only travel over HTTPS. Set TRUST_PROXY=true when
# behind such a proxy so the real client IP (used by rate limiting + the audit
# log at output/audit-log.json) and HTTPS detection (for HSTS) come from the
# X-Forwarded-For / X-Forwarded-Proto headers. Leave blank for direct/localhost.
TRUST_PROXY=
